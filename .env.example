ANTHROPIC_API_KEY="sk-ant-..."
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-key"

# --- Auth secrets: three different values, three different names (issue #20) ---
# These used to collide. Do not merge them back together.
#
# AUTH_TOKEN — the shared password for the legacy login gate
# (frontend/middleware.ts). The app is unreachable without it, and the frontend
# must see the same value. Being retired in #6 / #37.
AUTH_TOKEN=""
#
# RENDER_TOKEN — shared secret the web tier sends to the Remotion render
# service. Set in the frontend env; falls back to AUTH_TOKEN if unset, which
# it should not (#5).
#
# X_AUTH_TOKEN + CT0 — X/Twitter browser session cookies for last30days
# research. Optional; Reddit and Hacker News work without them. Renamed at the
# subprocess boundary in agents/last30days_agent.py, because last30days itself
# expects the cookie under the name AUTH_TOKEN — which here means something
# else entirely.
X_AUTH_TOKEN=""
CT0=""

# Slack approval flow (Phase 3)
# SLACK_BOT_TOKEN — Bot User OAuth Token (starts with xoxb-)
# SLACK_APP_TOKEN — App-Level Token with connections:write scope (starts with xapp-)
# SLACK_CHANNEL_ID — Channel ID where approval messages are posted (e.g. C0123456789)
SLACK_BOT_TOKEN="xoxb-..."
SLACK_APP_TOKEN="xapp-..."
SLACK_CHANNEL_ID="C0123456789"

# --- Research Agent (Reddit is optional — RSS feeds work without it) ---
# Create a Reddit app at: reddit.com/prefs/apps (script type)
REDDIT_CLIENT_ID="..."
REDDIT_CLIENT_SECRET="..."
REDDIT_USER_AGENT="2389Research/1.0"
