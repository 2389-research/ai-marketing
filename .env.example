# Backend environment. Copy to .env and fill in.
# The frontend has its own file — see frontend/.env.local.example.

# ── Required ─────────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY="sk-ant-..."
SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_KEY — the backend is trusted server-side code and should use the
# SERVICE ROLE key, not the anon key. The anon key happens to work today only
# because row-level security has never been enabled (issue #1).
SUPABASE_KEY="your-supabase-service-role-key"

# AUTH_TOKEN — shared password for the legacy login gate in
# frontend/middleware.ts. The app is unreachable without it. Must be the same
# value the frontend sees (frontend/.env.local).
#
# ⚠️ NAME COLLISION (issue #20): agents/last30days_agent.py reads AUTH_TOKEN as
# an X/Twitter session cookie and forwards it to the research subprocess.
# Setting this to your app password means that password is sent to X.
AUTH_TOKEN="a-long-random-string"

# ── Slack approval flow (optional) ───────────────────────────────────────────
# SLACK_BOT_TOKEN — Bot User OAuth Token (starts with xoxb-)
# SLACK_APP_TOKEN — App-Level Token with connections:write scope (starts with xapp-)
# SLACK_CHANNEL_ID — Channel ID where approval messages are posted
SLACK_BOT_TOKEN="xoxb-..."
SLACK_APP_TOKEN="xapp-..."
SLACK_CHANNEL_ID="C0123456789"

# ── Research sources (all optional — RSS works with none of them) ────────────
# Reddit: create an app at reddit.com/prefs/apps (script type)
REDDIT_CLIENT_ID="..."
REDDIT_CLIENT_SECRET="..."
REDDIT_USER_AGENT="YourOrg/1.0"

# YouTube Data API v3 — trend and transcript research
YOUTUBE_API_KEY=""

# NewsAPI (newsapi.org) — news candidates in the research agent
NEWS_API_KEY=""

# ── Media pipeline (optional — only for video/music generation) ──────────────
# Replicate — MusicGen background tracks via generate_music.py.
# NOTE: meta/musicgen weights are CC-BY-NC. Check that against your use.
REPLICATE_API_TOKEN=""

# Groq — Whisper transcription for video captions (falls back to local
# faster-whisper if unset)
GROQ_API_KEY=""

# ── Tuning (optional) ────────────────────────────────────────────────────────
# IANA timezone for scheduling. Must match NEXT_PUBLIC_SCHEDULE_TIMEZONE in the
# frontend and SCHEDULE_TIMEZONE in fly.toml.
SCHEDULE_TIMEZONE="America/Chicago"

# Fallback topics-per-run for the generation cron. Per-project setting on the
# Brand page wins over this.
CRON_TOPICS="3"

# Pin CLI runs to a single project (brand) UUID. Unset = the default project.
PROJECT_ID=""
