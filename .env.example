OPENAI_API_KEY="sk-proj-..."
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-key"

# Slack approval flow (Phase 3)
# SLACK_BOT_TOKEN — Bot User OAuth Token (starts with xoxb-)
# SLACK_APP_TOKEN — App-Level Token with connections:write scope (starts with xapp-)
# SLACK_CHANNEL_ID — Channel ID where approval messages are posted (e.g. C0123456789)
SLACK_BOT_TOKEN="xoxb-..."
SLACK_APP_TOKEN="xapp-..."
SLACK_CHANNEL_ID="C0123456789"

# --- Buffer Auto-Publishing ---
# Get your access token from: bufferapp.com/developers/apps
# Then run: python list_buffer_profiles.py  to find your profile IDs
BUFFER_ACCESS_TOKEN="..."
BUFFER_LINKEDIN_PROFILE_ID="..."
BUFFER_INSTAGRAM_PROFILE_ID="..."
BUFFER_TIKTOK_PROFILE_ID="..."
