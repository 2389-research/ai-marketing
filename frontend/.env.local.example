NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SCHEDULE_TIMEZONE=Europe/Amsterdam
OPENAI_API_KEY=your-openai-api-key

# Path to your Python executable (venv or system python3)
# e.g. /Users/you/Downloads/marketing-agent/.venv/bin/python
BACKEND_PYTHON=python3

# Path to the Python backend root (default: parent of this frontend folder)
