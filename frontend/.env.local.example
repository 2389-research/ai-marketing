# Frontend environment. Copy to .env.local and fill in.
# The Python backend has its own file — see ../.env.example.

# ── Required ─────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# SUPABASE_SERVICE_ROLE_KEY — used by the API routes under app/api/, which are
# trusted server-side code. Never prefix this with NEXT_PUBLIC_: anything so
# prefixed is inlined into the browser bundle and becomes public.
# Most API routes still use the anon key instead — see issue #1.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AUTH_TOKEN — shared password for the legacy login gate in middleware.ts. The
# app is unreachable without it. Must match AUTH_TOKEN in the backend .env.
AUTH_TOKEN=a-long-random-string

# Used by the /assistant route and draft composition.
ANTHROPIC_API_KEY=sk-ant-...

# ── Scheduling ───────────────────────────────────────────────────────────────
# Must match SCHEDULE_TIMEZONE in the backend .env and in fly.toml. Any IANA zone.
# NEXT_PUBLIC_* is inlined at build time, so changing it requires a rebuild.
SCHEDULE_TIMEZONE=America/Chicago
NEXT_PUBLIC_SCHEDULE_TIMEZONE=America/Chicago

# ── Running the Python backend from the UI ───────────────────────────────────
# The "Run now" buttons spawn the backend as a child process.
# Path to your Python executable (venv or system python3)
# e.g. /path/to/ai-marketing/.venv/bin/python
BACKEND_PYTHON=python3
# Path to the Python backend root (default: parent of this frontend folder)
# BACKEND_PATH=/path/to/ai-marketing

# ── Video rendering (optional) ───────────────────────────────────────────────
# render-server.mjs runs Remotion in a separate process. It refuses to start in
# production without a token, because /render is reachable on the public IPv6
# address. Falls back to AUTH_TOKEN if unset — set it explicitly.
RENDER_TOKEN=another-long-random-string
RENDER_PORT=3002
# Where the web tier forwards render requests. Local default is localhost.
RENDERER_URL=http://localhost:3002

# ── Image generation (optional) ──────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key

# ── Team invitation emails (optional) ────────────────────────────────────────
# Without RESEND_API_KEY every send is a graceful no-op and the UI falls back to
# a shareable join link.
RESEND_API_KEY=
RESEND_FROM=Your Org <team@yourdomain.com>
